# Copy this file to .env and put your real key there. Never commit .env.
MODEL_API_KEY=your-key-here
BASETEN_API_KEY=your-key-here

# Hosted demo settings (optional, not secrets; on a Hugging Face Space set
# them as Variables). Defaults in brackets.
# BEAMPILOT_LIVE_RUNS=on            # "off" switches live runs off; replay still works [on]
# BEAMPILOT_SPEND_CAP_USD=5         # live-run spend cap per server start, in USD [5]
# BEAMPILOT_TOKEN_CAP=60000000      # live-run token cap per server start [60000000]
